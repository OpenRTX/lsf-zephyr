/dts-v1/;
#include <csk/csk6.dtsi>
#include "csk6011a_9s_scanpen_pinctrl.dtsi"

/ {
        model = "csk6011a 9s scanpen";
        compatible = "csk,csk6011a_9s_scanpen";
        aliases {
                i2c-0 = &i2c0;
                i2c-1 = &i2c1;
                c-led = &camleds1;
                avf-audio-pwr-amp = &pwr_amp;
        };

        chosen {
                zephyr,console = &uart0;
                zephyr,shell-uart = &uart0;
                zephyr,sram = &sram0;
                zephyr,itcm = &itcm0;
                zephyr,flash = &flash0;
                zephyr,flash_controller = &flash;
                /* other chosen settings  for your hardware */

		zephyr,ipc_shm = &psram_share;
		zephyr,ipc = &mailbox0;
		zephyr,uart-mcumgr = &uart0;
        };

	gpio,user {
		compatible = "listenai,csk-gpio-user";
		fy_key: fykey {
			gpios = <&gpiob 4 1>;
			label = "fykey";
		};
                key_key: keykey {
			gpios = <&gpiob 5 1>;
			label = "keykey";
		};
	};

        leds {
                compatible = "gpio-leds";
                camleds1: cam_led_0 {
                        gpios = <&gpioa 10 0>;
                        label = "cam_led_0";
                };
        };

        wifi_module: xr819s {
                compatible = "wifi,xr819s";
                label = "WiFi module";
                dataready-gpios = <&gpioa 2 0>;
                reset-gpios = <&gpioa 6 0>;
                sdio-clk-gpios = <&gpioa 3 0>;
                sdio-cmd-gpios = <&gpioa 4 0>;
                sdio-dat0-gpios = <&gpioa 5 0>;
                status = "okay";
        };

        fstab {
                compatible = "zephyr,fstab";
                lfs1: lfs1 {
                        compatible = "zephyr,fstab,littlefs";
                        mount-point = "/lfs1";
                        partition = <&filesystem_part>;
                        read-size = <16>;
                        prog-size = <16>;
                        cache-size = <64>;
                        lookahead-size = <32>;
                        block-cycles = <512>;
                };
        };

        pwr_amp: audio_pwr_amp {
                compatible = "listenai,pwr-amp";
                enable-gpios = <&gpiob 6 0>;
                label = "audio_pwr_amp";
                status = "okay";
        };

        vbatt {
                compatible = "voltage-divider";
                io-channels = <&adc0 5>;
                output-ohms = <0>;
        };


        /*
         * Your board-specific hardware: buttons, LEDs, sensors, etc.
         */
};


&gpioa {
        status = "okay";
};

&gpiob {
        status = "okay";
};

&uart0 {
        pinctrl-0 = <&pinctrl_uart0_rx_default &pinctrl_uart0_tx_default>; 
        pinctrl-names = "default";
        current-speed = <921600>;
        status = "okay";
};

&uart1 {
        status = "disabled";
};

&uart2 {
        status = "disabled";
};

&spi0 {
        pinctrl-0 = <&pinctrl_spi0_sclk_default &pinctrl_spi0_mosi_default &pinctrl_spi0_miso_default &pinctrl_spi0_cs_default>; 
        pinctrl-names = "default";
        status = "disabled";
};

&spi1 {
        status = "okay";
        spi-max-frequency = <100000000>;
        pinctrl-0 = <&pinctrl_spi1_sclk_default &pinctrl_spi1_mosi_default &pinctrl_spi1_cs_default>;
        pinctrl-names = "default";
};

&i2c0 {
        status = "disabled";
};


&i2c1 {
        status = "okay";
        pinctrl-0 = <&pinctrl_i2c1_scl_default &pinctrl_i2c1_sda_default>;
        pinctrl-names = "default";

        bf30a2: bf30a2@6e {
            compatible = "byd,bf30a2";
            status = "okay";
            label = "VIDEO";
            reg = <0x6e>;
            xclk-gpios = <&gpioa 11 0>;
            product-id = <0x3b02>;
            spi = <&spi1>;
        };
};

&gpt0 {
	status = "okay";
};



&mailbox0 {
	status = "okay";
};

&dma0 {
	dma-channels = <6>;
	status = "okay";
};

&rtc1 {
        status = "okay";
};

&flash0 {
        /*
         * For more information, see:
         * http: //docs.zephyrproject.org/latest/guides/dts/index.html#flash-partitions
         */
        reg = <0x18000000 DT_SIZE_M(32)>;
        write-block-size = <4>;
        partitions {
                compatible = "fixed-partitions";
                #address-cells = < 0x1 >;
                #size-cells = < 0x1 >;
                boot_partition: partition@0 {
                        label = "mcuboot";
                        reg = < 0x0 0x40000 >;
                        read-only;
                };
                slot0_partition: partition@40000 {
                        label = "image-0";
                        reg = < 0x40000 0x100000 >;
                };
                slot1_partition: partition@140000 {
                        label = "image-1";
                        reg = < 0x140000 0x100000 >;
                };
                scratch_partition: partition@240000 {
                        label = "image-scratch";
                        reg = < 0x240000 0x20000 >;
                };
                filesystem_part: partition@260000 {
                        label = "filesystem";
                        reg = < 0x260000 0x2a0000 >;
                        phandle = < 0x12 >;
                };
                hifi4_partition: partition@500000 {
                        label = "cp-image";
                        reg = < 0x500000 0x300000 >;
                };
                cutline_partition: partition@800000 {
                        label = "cutline";
                        reg = < 0x800000 0x80000 >;
                };
                ocr_partition: partition@880000 {
                        label = "ocr";
                        reg = < 0x880000 0x280000 >;
                };
                tts_partition: partition@b00000 {
                        label = "tts";
                        reg = < 0xb00000 0x480000 >;
                };
                trans_partition: partition@f80000 {
                        label = "trans";
                        reg = < 0xf80000 0x1000000 >;
                };
        };
};

&psram0 {
        reg = <0x30000000 DT_SIZE_M(8)>;
        #address-cells = <1>;
        #size-cells = <1>;

        /*psram for cp core slot: 6MB */
        psram_cp:psram_cp@30000000{
                compatible = "listenai,csk6-psram-partition";
                reg = <0x30000000 0x600000>;
                status = "okay";
        };

        /*psram for ap core slot: 1.6875MB */
        psram_ap: psram_ap@30600000 {
                compatible = "listenai,csk6-psram-partition";
                reg = <0x30600000 0x1b0000>;
                status = "okay";
        };

        /*psram for ap share with cp slot: 512KB */
        psram_share: psram_share@307b0000 {
                compatible = "listenai,csk6-psram-partition";
                reg = <0x307b0000 0x50000>;
                status = "okay";
        };
};

&wdt {
        status = "disabled";
};
