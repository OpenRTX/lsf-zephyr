#include <listenai/ls_csk6.dtsi>

&psram0 {
    reg = <0x60000000 DT_SIZE_M(8)>;

    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        psram_cp: partition@60000000 {
            label = "psram_cp";
            reg = <0x60000000 0x400000>;
        };

        psram_ap: partition@60400000 {
            label = "psram_ap";
            reg = <60400000 80000>;
        };

        psram_share: partition@60380000 {
            label = "psram_share";
            reg = <60380000 0x80000>;
        };
    };
};