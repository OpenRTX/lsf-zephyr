menuconfig WIFI_MANAGER
	bool "WiFi Manager Support"
	select NVS
	select FLASH
	select FLASH_PAGE_LAYOUT
	select FLASH_MAP
	select MPU_ALLOW_FLASH_WRITE


if WIFI_MANAGER

	config WIFI_MGR_WORKQ_STACK
		int "WiFi Manager Workq Stack"
		default 1024

	config WIFI_MGR_WORKQ_PRIORITY
		int "WiFi Manager Workq priority"
		default 5

	module = WIFI_MANAGER
	module-str = wifi_manager
	source "subsys/logging/Kconfig.template.log_config"
endif #WIFI_MANAGER
