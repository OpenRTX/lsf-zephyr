DT_CHOSEN_Z_SRAM0 := zephyr,sram
DT_CHOSEN_Z_PSRAM_AP := zephyr,psram_ap
DT_CHOSEN_Z_PSRAM_SHARE := zephyr,psram_share

if SOC_SERIES_LS_CSK6

# This series does not have MISC0.
# Since EXCSAVE7 is unused by Zephyr, use it instead.
config XTENSA_KERNEL_CPU_PTR_SR
	default "EXCSAVE2"

config SOC_SERIES
	string
	default "csk6"

config SOC_TOOLCHAIN_NAME
	string
	default "ls_csk_adsp"

config SOC
	string
	default "ls_csk6"

config SMP
	default n

config XTENSA_TIMER
	default y

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 300000000 if XTENSA_TIMER

config SYS_CLOCK_TICKS_PER_SEC
	default 50000

config KERNEL_ENTRY
	default "__start"

config MULTI_LEVEL_INTERRUPTS
	default n

config 2ND_LEVEL_INTERRUPTS
	default n

config DYNAMIC_INTERRUPTS
	default y

config LOG
	default y

config CP_XIP
	bool "Enable DSP runs in xip mode"
	default n
		
config CP_XIP_RUN_ADDRESS
	hex "DSP XIP run address"
	default 0x68500000 if CP_XIP

config CP_XIP_MAX_SIZE
	hex "DSP XIP max size"
	default 0x300000 if CP_XIP	

# To prevent test uses TEST_LOGGING_MINIMAL
config TEST_LOGGING_DEFAULTS
	default n
	depends on TEST


config SRAM0_START
	hex
	default "$(dt_chosen_reg_addr_hex,$(DT_CHOSEN_Z_SRAM0))"
	help
	  psram cp start address

config SRAM0_SIZE
	hex
	default "$(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_SRAM0))"
	help
	  psram cp start size

config PSRAM_AP_START
	hex
	default "$(dt_chosen_reg_addr_hex,$(DT_CHOSEN_Z_PSRAM_AP))"
	help
	  psram ap start address

config PSRAM_AP_SIZE
	hex
	default "$(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_PSRAM_AP))"
	help
	  psram ap start size

config PSRAM_SHARE_START
	hex
	default "$(dt_chosen_reg_addr_hex,$(DT_CHOSEN_Z_PSRAM_SHARE))"
	help
	  psram share start address

config PSRAM_SHARE_SIZE
	hex
	default "$(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_PSRAM_SHARE))"
	help
	  psram share start size

endif # SOC_SERIES_LS_CSK6
