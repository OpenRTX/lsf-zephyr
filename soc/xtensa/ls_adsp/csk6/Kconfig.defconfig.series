if SOC_SERIES_LS_CSK6

# This series does not have MISC0.
# Since EXCSAVE7 is unused by Zephyr, use it instead.
config XTENSA_KERNEL_CPU_PTR_SR
	default "EXCSAVE2"

config SOC_SERIES
	string
	default "csk6"

config SOC_TOOLCHAIN_NAME
	string
	default "ls_csk_adsp"

config SOC
	string
	default "ls_csk6"

config SMP
	default n

config XTENSA_TIMER
	default y

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 300000000 if XTENSA_TIMER

config SYS_CLOCK_TICKS_PER_SEC
	default 50000

config KERNEL_ENTRY
	default "__start"

config MULTI_LEVEL_INTERRUPTS
	default n

config 2ND_LEVEL_INTERRUPTS
	default n

config DYNAMIC_INTERRUPTS
	default y

config LOG
	default y

config CP_XIP
	bool "Enable DSP runs in xip mode"
	default n
		
config CP_XIP_RUN_ADDRESS
	hex "DSP XIP run address"
	default 0x68500000 if CP_XIP

config CP_XIP_MAX_SIZE
	hex "DSP XIP max size"
	default 0x300000 if CP_XIP	

# To prevent test uses TEST_LOGGING_MINIMAL
config TEST_LOGGING_DEFAULTS
	default n
	depends on TEST

endif # SOC_SERIES_LS_CSK6
