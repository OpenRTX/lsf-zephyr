# SPDX-License-Identifier: Apache-2.0

config SOC_CSK6
	bool "SOC_CSK6"
	select ARM
	select CPU_CORTEX_M33
	select CPU_CORTEX_M_HAS_DWT
	select CPU_HAS_ARM_SAU
	select CPU_HAS_FPU
	select CPU_HAS_MPU
	select CPU_HAS_ARM_MPU
	select ARMV8_M_DSP
	select CPU_CORTEX_M_HAS_SYSTICK
	select HAS_CSK6
	select CPU_HAS_CUSTOM_FIXED_SOC_MPU_REGIONS

config HAS_CSK6
	bool
	select HAS_CMSIS_CORE
	depends on SOC_CSK6


if SOC_CSK6

	config CSK6_PSRAM
		bool "Enable CSK6 PSRAM"
		default n
		help
			Enable CSK6 PSRAM

endif # SOC_CSK6
