# ESP32 board configuration


if SOC_CSK6


config SOC
	default "csk6"

config NUM_IRQS
	default 32

config HAS_CSK6_GPT
	bool
	help
	  Set if the general purpose timer (GPT) module is present in the SoC.

DT_CSK6_FLASH := $(dt_nodelabel_path,flash0)
DT_CSK6_FLASH_WRITE_BLOCK_SIZE := $(dt_node_int_prop_int,$(DT_CSK6_FLASH),write-block-size)

config FLASH_WRITE_BLOCK_SIZE
	int "Number of flash write block size"
	default "$(DT_CSK6_FLASH_WRITE_BLOCK_SIZE)"
	default 1
endif