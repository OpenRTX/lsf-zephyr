# ESP32 board configuration


if SOC_CSK6


config SOC
	default "csk6"

config NUM_IRQS
	default 32

config HAS_CSK6_GPT
	bool
	help
	  Set if the general purpose timer (GPT) module is present in the SoC.

config FLASH_CHIP_SIZE
	int "Number of flash chip, it's different from FLASH_SIZE,FLASH_SIZE may be just ap partition on csk6"
	default $(dt_node_reg_size_int,/soc/flash-controller@46400000/flash@18000000,0,M) 

endif