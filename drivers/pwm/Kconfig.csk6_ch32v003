config PWM_CSK6_CH32V003
	bool "CSK6 CH32V003 PWM driver"
	depends on HAS_CSK6
	select I2C
	select CSK6_EXMCU
	default n
	help
		CSK6 CH32V003 PWM driver

config PWM_CSK6_CH32V003_INIT_PRIORITY
	int "CSK6 CH32V003 PWM driver priority"
	depends on PWM_CSK6_CH32V003
	default 52
	help
		CSK6 CH32V003 PWM driver priority

config PWM_CSK6_CH32V003_DTG
	hex "CSK6 CH32V003 deadtime register value"
	depends on PWM_CSK6_CH32V003
	range 0 0xFF
	default 0
	help
	  CSK6 CH32V003 deadtime register value

config PWM_CSK6_CH32V003_BRAKE
	bool "CSK6 CH32V003 brake enable"
	depends on PWM_CSK6_CH32V003_DTG > 0
	default n
	help
	  CSK6 CH32V003 deadtime register value