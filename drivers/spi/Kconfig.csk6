# SPDX-License-Identifier: Apache-2.0

menuconfig SPI_CSK6
	bool "CSK6 SPI driver"
	default y
	depends on HAS_CSK6
	help
	  Enable the csk6 SPI driver.

if SPI_CSK6

config SPI_TX_DMA
	bool "Enable SPI TX DMA"
	default y
	select DMA

config SPI_RX_DMA
	bool "Enable SPI RX DMA"
	default y
	select DMA

config SPI_TX_DMA_WITHOUT_INT
	bool "Enable SPI TX DMA without dma channel interrupt"
	default n
	depends on SPI_TX_DMA
	help
		Do not enable this option unless you know what you are doing.

config SPI_TX_DMA_FIX_CHANNEL
	int "select a fixed channel for spi transfer."
	default 1
	depends on SPI_TX_DMA_WITHOUT_INT

endif #SPI_CSK6
