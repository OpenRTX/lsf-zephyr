config ENTROPY_CSK6_RNG
	bool "CSK6 entropy number generator driver"
	depends on HAS_CSK6
	select ENTROPY_HAS_DRIVER
	default y
	help
	  This option enables the entropy number generator for CSK6 SoCs.
