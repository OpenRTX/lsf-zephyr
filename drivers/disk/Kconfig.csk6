# SPDX-License-Identifier: Apache-2.0

if SDMMC_CSK6

config SDMMC_NON_BLOCK_INIT
    bool "CSK6 SDMMC Non-Block Init"
    select EVENTS
    help
        Make the CSK6 SDMMC Driver init into non-block

config SDMMC_CSK6_SRAM_CACHE_ACCESS
    bool "CSK6 SDMMC SRAM Cache Access"
    select DMA
    select DMA_CSK6
    default n
    help
        CSK6 SDMMC SRAM Cache Access

config SDMMC_CSK6_SRAM_CACHE_SIZE
    int "CSK6 SDMMC SRAM Cache Size"
    default 51200
    depends on SDMMC_CSK6_SRAM_CACHE_ACCESS
    help 
        CSK6 SDMMC SRAM Cache Size

config SDMMC_CSK6_SRAM_CACHE_NUM
    int "CSK6 SDMMC SRAM Cache Number"
    default 1
    range 0 1
    depends on SDMMC_CSK6_SRAM_CACHE_ACCESS
    help
        CSK6 SDMMC SRAM Cache Number

config SDMMC_CSK6_SRAM_CACHE_DMA_COPY_THRESHOLD
    int "CSK6 SDMMC SRAM Cache dma copy threshold"
    default 5120
    depends on SDMMC_CSK6_SRAM_CACHE_ACCESS
    help
        CSK6 SDMMC SRAM Cache dma copy threshold

config SDMMC_CSK6_DMA_CHANNEL
    int "CSK6 SDMMMC DMA Channel"
    default 1
    depends on SDMMC_CSK6_SRAM_CACHE_ACCESS
    help 
        CSK6 SDMMMC DMA Channel

config SDMMC_CSK6_CRYPTO_ENABLE
    bool "Enable CSK6 SDMMC  encrypt/decrypt partition" 
    default n
    depends on MBEDTLS
    help 
        Enable CSK6 SDMMC  encrypt/decrypt partition

if SDMMC_CSK6_CRYPTO_ENABLE

config SDMMC_CSK6_CRYPTO_KEY
    string "Enable CSK6 SDMMC  encrypt/decrypt key"
    default "0123456789abcdef"
    help 
        Enable CSK6 SDMMC  encrypt/decrypt key

config SDMMC_CSK6_CRYPTO_BUFFER_SIZE
    hex "CSK6 SDMMC encrypt buffer size"
    default 0x200
    help 
        CSK6 SDMMC encrypt buffer size

config SDMMC_CSK6_CRYPTO_PARTITION_START_SECTOR
    hex "CSK6 SDMMC encrypt/decrypt partition start sector"
    default 0x00
    help 
        CSK6 SDMMC encrypt/decrypt partition address

config SDMMC_CSK6_CRYPTO_PARTITION_NUMBER_SECTOR
    hex "CSK6 SDMMC encrypt/decrypt partition number sector"
    default 0x00
    help 
        CSK6 SDMMC encrypt/decrypt partition size

endif
endif # SDMMC_CSK6
