# SPDX-License-Identifier: Apache-2.0

if SDMMC_CSK6

config SDMMC_NON_BLOCK_INIT
    bool "CSK6 SDMMC Non-Block Init"
    select EVENTS
    help
        Make the CSK6 SDMMC Driver init into non-block

config SDMMC_CSK6_SRAM_CACHE_ACCESS
    bool "CSK6 SDMMC SRAM Cache Access"
    select DMA
    select DMA_CSK6
    default n
    help
        CSK6 SDMMC SRAM Cache Access

config SDMMC_CSK6_SRAM_CACHE_SIZE
    int "CSK6 SDMMC SRAM Cache Size"
    default 51200
    depends on SDMMC_CSK6_SRAM_CACHE_ACCESS
    help 
        CSK6 SDMMC SRAM Cache Size

config SDMMC_CSK6_SRAM_CACHE_NUM
    int "CSK6 SDMMC SRAM Cache Number"
    default 1
    depends on SDMMC_CSK6_SRAM_CACHE_ACCESS
    help
        CSK6 SDMMC SRAM Cache Number


endif # SDMMC_CSK6
