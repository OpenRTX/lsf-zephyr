if USB_DEVICE_DRIVER

config USB_DC_CSK6
	bool "USB device controller driver for CSK6 devices"
	default y
	depends on HAS_CSK6
	help
	  Enable USB support on the csk6 processors.

config USB_DC_CSK6_THREAD_STACK_SIZE
	int "USBD thread stack size"
	default 1024
	depends on USB_DC_CSK6
	help
	  Size of the stack for the work queue thread that is used in the driver
	  for handling the events from the USBD ISR, i.e. executing endpoint
	  callbacks and providing proper notifications to the USB device stack.

config USB_DC_CSK6_THREAD_COOP_PRIO
	int "USBD thread cooperative priority"
	range 0 NUM_COOP_PRIORITIES
	default 2
	depends on USB_DC_CSK6
	help
	   Priority of the driver's thread. The smaller the number, the higher the priority,

if USB_MCUX



endif # USB_MCUX


endif # USB_DEVICE_DRIVER
