config KSCAN_SPD2010
	bool "SPD2010 keyscan driver"
	depends on I2C
	depends on SPD2010
	select SPD2010_TOUCH
	help
		SPD2010 integrates display and touch,
		and the initialization of touch depends on the display,
		so the touch function cannot be used alone

config KSCAN_SPD2010_DELAY_TIME_MS
	int "SPD2010 scan delay time without interrupt"
	default 5
	depends on KSCAN_SPD2010
	help
		SPD2010 scan delay time without interrupt

config KSCAN_SPD2010_RELEASE_WEIGHT
	int "SPD2010 release weight"
	default 20
	depends on KSCAN_SPD2010
	help
	  SPD2010 release weight

config KSCAN_SPD2010_REPORT_FILTER
	bool "SPD2010 report filter"
	default y
	depends on KSCAN_SPD2010
	help
	   SPD2010 report filter

config KSCAN_SPD2010_REPORT_FILTER_TIME_MS
	int "SPD2010 report filter time ms"
	default 50
	depends on KSCAN_SPD2010_REPORT_FILTER
	help
	  SPD2010 report filter time ms
