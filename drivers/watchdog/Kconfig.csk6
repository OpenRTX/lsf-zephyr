# Microchip CSK6 Watchdog Timer configuration

# Copyright (c) 2022 listenai
# SPDX-License-Identifier: Apache-2.0

config WDT_CSK6
	bool "Microchip CSK series Watchdog Timer (WDT) driver"
	default y
	help
	  Enable WDT driver for Microchip CSK MCU series.

config WDT_CSK_SOURCE_NUM_PER_MS
	int
	default 32
	help
		Set the number of wdt register value per ms