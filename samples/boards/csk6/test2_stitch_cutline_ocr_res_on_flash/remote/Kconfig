config SOF_AI_CV
	bool "Sof camera image ai"
	default n
	help
	  Select for Sof camera image ai support.
	  This will cause cv to include camera image ai library.

config SOF_AI_CUTLINE_RES_ADDR
	hex "Sof cutline algorithm resource address"
	default 0x68800000
	depends on SOF_AI_CV
	help
	  Sof cutline algorithm resource address.
	
config SOF_AI_CUTLINE_RES_SIZE
	hex "Sof cutline algorithm resource size"
	default 430632
	depends on SOF_AI_CV
	help
	  Sof cutline algorithm resource size.

