/delete-node/ &storage_partition;

/ {
	chosen {
		/*
		 * shared memory reserved for the inter-processor communication
		 */
		zephyr,ipc_shm = &sramx1;
		zephyr,ipc = &mailbox0;
		zephyr,flash_sysfs_storage = &filesystem_part;
		zephyr,flash_controller = &flash;
		zephyr,uart-mcumgr = &uart0;
		zephyr,lisa_heap = &psram_region1;
	};
	sramx1:memory@30700000{
		compatible = "mmio-sram";
		reg = <0x30700000 0x100000>;
	};
	psram_region1:memory@30600000{
		compatible = "mmio-sram";
		reg = <0x30600000 0x100000>;
	};
	fstab {
		compatible = "zephyr,fstab";
		lfs1: lfs1 {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs1";
			partition = <&filesystem_part>;
			automount ;
			no-format;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};

    pwmleds {
		compatible = "pwm-leds";
		green_pwm_led: green_pwm_led {
			pwms = <&pwm4 4 PWM_POLARITY_NORMAL>;
			label = "User BOARD_LED_2 - PWM0";
		};
	};

	gpio_keys {
user_button_0: button_0 {
				   label = "User SW0";
				   gpios = < &gpiob 0x5 0x0 >;
			   };
	};

};


&flash0 {
	partitions {
		compatible = "fixed-partitions";
#address-cells = <1>;
#size-cells = <1>;
filesystem_part: partition@160000 {
					 label = "filesystem";
					 reg = <0x160000 0x00600000>;
				 };
				 /*
				  * Reserve the final 640 KiB for file system partition
		 */
		storage_partition: partition@760000 {
			label = "storage";
			reg = <0x760000 0x00a0000>;
		};


	};
};

&zephyr_udc0 {
	cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "CDC_ACM_0";
	};
};

&gpt0 {
	status = "okay";

    pwm5: pwm5 {
        status = "disabled";
    };

	pwm4: pwm4 {
        pinmuxs = <&pinmuxa 4 11>;
        clock-prescaler = <1>;
        status = "okay";
    };
};

&spi0 {
    status = "okay";
    spi-max-frequency = <25000000>;
};

&spi1 {
    status = "disabled";
};

&i2c0 {
        status = "okay";
        pinmuxs = <&pinmuxb 0 8>, <&pinmuxb 1 8>;
        pinmux-names = "SCL", "SDA";

        bf30a2: bf30a2@6e {
            compatible = "byd,bf30a2";
            status = "okay";
            label = "VIDEO";
            reg = <0x6e>;
            pd-gpios = <&gpioa 1 0>;
            pwr-gpios = <&gpioa 5 0>;
            product-id = <0x3b02>;
            spi = <&spi0>;
            xclk-pwm = <&pwm4>;
            xclk-freq = <12500>;
            csk6-spec;
    };
};

&i2c1 {
    status = "disabled";
};

&uart0 {
    current-speed = <115200>;
};

&uart1 {
    status = "disabled";
    current-speed = <115200>;
	pinmuxs = < &pinmuxa 8 3>, < &pinmuxa 9 3>;
};

