menu "Example Configuration"

    config EXAMPLE_WIFI_SSID
        string "WiFi SSID"
        default "TP-LINK_BA83"
        #default "TP-LINK_LINGSI"

    config EXAMPLE_WIFI_PASSWORD
        string "WiFi password"
        default "ab123456"
        #default "a123456789"

endmenu

config LISA_HEAP_ARENA_SIZE
	int "Size of the lisa mem malloc arena"
	default 0
	help
	  Indicate the size in bytes of the memory arena used for
	  lisa_mem's malloc() implementation.



source "Kconfig.zephyr"
