DT_CHOSEN_Z_IPC_SHM := zephyr,ipc_shm
DT_CHOSEN_Z_FLASH_PARTITION1 := zephyr,flash_partitions1
DT_CHOSEN_Z_FLASH_PARTITION2 := zephyr,flash_partitions2
#SOF IPC MEMORY CONFIG
config AVF_IPC_SHM_BASE_ADDRESS
	default "$(dt_chosen_reg_addr_hex,$(DT_CHOSEN_Z_IPC_SHM))"

config AVF_IPC_SHM_SIZE
	default "$(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_IPC_SHM))"
	help
	  This option specifies size of the memory region to be used
	  for the SOF IPC shared memory

config FLASH_CP_IAMGE_ADDRESS
	hex "second core firmware space start address"
	default "$(dt_chosen_reg_addr_hex,$(DT_CHOSEN_Z_FLASH_PARTITION1))"

config FLASH_CP_IAMGE_SIZE
	hex "second core firmware space size"
	default "$(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_FLASH_PARTITION1))"

config FLASH_TTS_DATA_ADDRESS
	hex "TTS algorithm resource data space start address"
	default "$(dt_chosen_reg_addr_hex,$(DT_CHOSEN_Z_FLASH_PARTITION2))"

config FLASH_TTS_DATA_SIZE
	hex "TTS algorithm resource data space size"
	default "$(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_FLASH_PARTITION2))"

source "Kconfig.zephyr"
