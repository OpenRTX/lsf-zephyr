/delete-node/ &psram_cp;
/delete-node/ &psram_ap;
/delete-node/ &psram_share;
/delete-node/ &wifi_driver_storage;
/delete-node/ &wifi_nvs_storage;
/delete-node/ &storage_partition;
/ {
	chosen {
		/*
		 * shared memory reserved for the inter-processor communication
		 */
		zephyr,ipc_shm = &psram_share;
		zephyr,ipc = &mailbox0;
		zephyr,flash_partitions1 = &flash_cp_image;
		zephyr,flash_partitions2 = &flash_tts_data;
	};

	aliases {
		avf-audio-pwr-amp = &pwr_amp;
	};
	pwr_amp: audio_pwr_amp{
		compatible = "listenai,pwr-amp";
		enable-gpios = <&gpioa 4 1>;
		label = "audio_pwr_amp";
		status = "okay";
	};

};

&psram0 {
	psram_cp: psram_cp@30000000 {
		compatible = "listenai,csk6-psram-partition";
		reg = <0x30000000 0x600000>;
		status = "okay";
	};
	psram_ap: psram_ap@30600000 {
		compatible = "zephyr,memory-region","listenai,csk6-psram-partition";
		reg = <0x30600000 0x1b0000>;
		status = "okay";
		zephyr,memory-region = "PSRAMAP";


	};
	psram_share: psram_share@307b0000 {
		compatible = "listenai,csk6-psram-partition";
		reg = <0x307b0000 0x50000>;
		status = "okay";
	};
};

&flash0 {

	partitions {
		flash_ap_image: flash_ap_image@0 {
			label = "flash-ap-image";
			reg = <0x0 0x400000>;
			read-only;
		};

		flash_cp_image: flash_cp_image@400000 {
			label = "flash-cp-image";
			reg = <0x400000 0x180000>;
			read-only;
		};

		flash_tts_data: flash_tts_data@580000 {
			label = "flash-tts-data";
			reg = <0x580000 0x280000>;
			read-only;
		};
	};
};
