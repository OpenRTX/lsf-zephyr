 &pinctrl {

	pinctrl_i2c0_scl_default: i2c0_scl_default{
		pinctrls = <I2C0_SCL_GPIOB_10>;
	};

	pinctrl_i2c0_sda_default: i2c0_sda_default{
		pinctrls = <I2C0_SDA_GPIOB_11>;
	};

	pinctrl_spi0_sclk_default: spi0_sclk_default {
		pinctrls = <SPI0_CLK_GPIOA_07>;
	};
	pinctrl_spi0_mosi_default: spi0_mosi_default {
		pinctrls = <SPI0_MOSI_GPIOA_06>;
	};

	pinctrl_spi0_cs_default: spi0_cs_default {
		pinctrls = <SPI0_CS_N_GPIOA_04>;
	};
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&pinctrl_spi0_sclk_default &pinctrl_spi0_mosi_default &pinctrl_spi0_cs_default>;
	pinctrl-names = "default";
	
	spd2010_display@0 {
		height = <452>;
		width = <180>;
		compatible = "solomon,spd2010-display";
		label = "DISPLAY";
		reg = <0>;
		cmd-data-gpios = <&gpioa 15 1>;
		reset-gpios = <&gpioa 9 1>;
		// te-gpios = <&gpiob 0x5 1>;
		x-offset = <0>;
		y-offset = <0>;
		spi-max-frequency = <50000000>;
	};
	
};
&i2c0 {
	status = "okay";
	pinctrl-0 = <&pinctrl_i2c0_scl_default &pinctrl_i2c0_sda_default>;
	pinctrl-names = "default";
	spd2010_kscan@0 {
		compatible = "solomon,spd2010-kscan";
		reg = <0>;
		label = "SPD2010";
		status = "okay";
		int-gpios = <&gpioa 16 1>;
		reset-gpios = <&gpioa 5 1>;
	};
};
