&csk6002_c3_nano_pinctrl{
                pinctrl_i2c0_scl_default: i2c0_scl_default{
                        pinctrls = <&pinmuxa 4 8>;
                };
                
                pinctrl_i2c0_sda_default: i2c0_sda_default{
                        pinctrls = <&pinmuxa 5 8>;
                };    

                pinctrl_spi0_sclk_default: spi0_sclk_default {
                        pinctrls = < &pinmuxa 19 6 >;
                };
                pinctrl_spi0_mosi_default: spi0_mosi_default {
                        pinctrls = < &pinmuxa 18 6 >;
                };
                pinctrl_spi0_miso_default: spi0_miso_default {
                        pinctrls = < &pinmuxa 17 6 >;
                };
                pinctrl_spi0_cs_default: spi0_cs_default {
                        pinctrls = < &pinmuxa 20 6 >;
                }; 
};

&spi0 {
    status = "okay";
    pinctrl-0 = <&pinctrl_spi0_sclk_default &pinctrl_spi0_mosi_default &pinctrl_spi0_miso_default &pinctrl_spi0_cs_default>; 
    pinctrl-names = "default";
    
    display: ili9341@0 {
        compatible = "ilitek,ili9341";
        status = "okay";
        label = "ILI9341";
        reg = <0>;
        display-inversion;
        rotation = <0>;
        pixel-format = <1>;
        reset-gpios = <&gpioa 8 1>;
        cmd-data-gpios = <&gpioa 9 1>;
        spi-max-frequency = <25000000>;
        pwctrla = [ 39 2c 00 34 02  ];
        pwctrlb = [ 00 c1 30  ];
        timctrla = [ 85 00 78  ];
        timctrlb = [ 00 00  ];
        pwseqctrl = [ 64 03 12 81  ];
        pwctrl1 = [ 1d  ];
        pwctrl2 = [ 12  ];
        vmctrl1 = [ 33 3f  ];
        vmctrl2 = [ 92  ];
        frmctr1 = [ 00 12  ];
        disctrl = [ 08 82 27  ];
        enable3g = [ 02  ];
        gamset = [ 01  ];
        pumpratioctrl = [ 10  ];
        pgamctrl = [ 0f 22 1c 1b 08 0f 48 b8 34 05 0c 09 0f 07 00  ];
        ngamctrl = [ 00 23 24 07 10 07 38 47 4b 0A 13 06 30 38 0f  ];
        etmod = [ 06  ];
};
};

&i2c0 {
        status = "okay";
        pinctrl-0 = <&pinctrl_i2c0_scl_default &pinctrl_i2c0_sda_default>; 
        pinctrl-names = "default";
        bl6xxx@0 {
                compatible = "betterlife,bl6xxx";
                reg = <0>;
                label = "BL6XXX";
                status = "okay";
                int-gpios = <&gpioa 16 0>;
                reset-gpios = <&gpioa 15 0>;
        };
};

