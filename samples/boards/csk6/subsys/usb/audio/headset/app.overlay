#define MICROPHONE    0x0201
#define DESKTOP_MIC   0x0202
#define PERSONAL_MIC  0x0203

#define SPEAKER        0x0301
#define HEADPHONES     0x0302
#define HEAD_AUDIO     0x0303

&zephyr_udc0 {
	hs_0 {
		label = "HEADSET";
		compatible = "usb-audio-hs";
		mic-feature-mute;
		mic-channel-l;
		mic-channel-r;
		mic-device-type = <MICROPHONE>;

		hp-feature-mute;
		hp-channel-l;
		hp-channel-r;
		hp-feature-volume;
		hp-device-type = <SPEAKER>;
	};
};
