/{
    aliases {
        led0 = &green_led;
    };
    
    leds {
        compatible = "gpio-leds";
        green_led: led1 {
                gpios = <&gpiob 6 GPIO_ACTIVE_LOW>;
                label = "User LED1";
        };
    };
};
