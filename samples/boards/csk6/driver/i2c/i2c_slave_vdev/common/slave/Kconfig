#
# I2C options
#
menuconfig I2C_SLAVE
	bool "I2C Slave Drivers"
	help
	  Enable I2C Slave Driver Configuration

if I2C_SLAVE

config I2C_SLAVE_INIT_PRIORITY
	int "Init priority"
	default 60
	help
	  I2C Slave device driver initialization priority.

config I2C_SLAVE_VIRTUAL_DEVICE
	bool "I2C Slave Virtual Device driver"
	help
	  Enable I2C Slave Virtual Device driver


endif # I2C_SLAVE
