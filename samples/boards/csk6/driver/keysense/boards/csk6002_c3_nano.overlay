&keysense {
    status = "okay";

	//keysense use adc channel 6 to sample
    io-channels = <&adc0 6>;

    //Trigger voltage of each analog key (mV)
    analogkey-trigger = <1100 1890 2570>;
};


/ {
     aliases {
        analogkey = &keysense;
     };
};

&adc0 {
        status = "okay";
};