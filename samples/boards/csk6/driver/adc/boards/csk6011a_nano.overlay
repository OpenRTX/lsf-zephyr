&pinctrl {
                /* ADC alternate function */
                pinctrl_adc0_ch0_default: adc0_ch0_default{
                    pinctrls = <GPADC_0_GPIOB_06>;
                };
                
                pinctrl_adc0_ch1_default: adc0_ch1_default{
					pinctrls = <GPADC_1_GPIOB_07>;
                };

                pinctrl_adc0_ch2_default: adc0_ch2_default{
                    pinctrls = <GPADC_2_GPIOB_08>;
                };

                pinctrl_adc0_ch3_default: adc0_ch3_default{
                    pinctrls = <GPADC_3_GPIOB_09>;
                };

};

/ {
    zephyr,user {
        io-channels = <&adc0 1>, <&adc0 2>, <&adc0 3>;
    };
};

&adc0 {
		pinctrl-0 = <&pinctrl_adc0_ch1_default &pinctrl_adc0_ch2_default &pinctrl_adc0_ch3_default>; 
        pinctrl-names = "default";
        status = "okay";
};
