&csk6002_c3_nano_pinctrl{

                pinctrl_pwm4_default: pwm4_default{
                    pinctrls = <&pinmuxa 4 11>;
                };  

                pinctrl_i2c0_scl_default: i2c0_scl_default{
                        pinctrls = <&pinmuxb 0 8>;
                };
                
                pinctrl_i2c0_sda_default: i2c0_sda_default{
                        pinctrls = <&pinmuxb 1 8>;
                };    

                pinctrl_uart1_rx_default: uart1_rx_default{
                        pinctrls = <&pinmuxa 8 3>;
                };
                
                pinctrl_uart1_tx_default: uart1_tx_default{
                        pinctrls = <&pinmuxa 9 3>;
                };     

};

/{
    pwmleds {
		compatible = "pwm-leds";
		green_pwm_led: green_pwm_led {
			pwms = <&pwm4 4 PWM_POLARITY_NORMAL>;
			label = "User BOARD_LED_2 - PWM0";
		};
	};
};

&gpt0 {
	status = "okay";

    pwm5: pwm5 {
        status = "disabled";
    };

	pwm4: pwm4 {
        clock-prescaler = <1>;
        status = "okay";
    };
};

&spi0 {
    status = "okay";
    spi-max-frequency = <25000000>;
};

&spi1 {
    status = "disabled";
};

&i2c0 {
        status = "okay";

        bf30a2: bf30a2@6e {
            compatible = "byd,bf30a2";
            status = "okay";
            label = "VIDEO";
            reg = <0x6e>;
            pd-gpios = <&gpioa 1 0>;
            pwr-gpios = <&gpioa 5 0>;
            product-id = <0x3b02>;
            spi = <&spi0>;
            pwms = <&pwm4 0x4 0x0>;
            xclk-freq = <12500>;
            csk6-spec;
        };
};

&i2c1 {
    status = "disabled";
};

&uart0 {
    current-speed = <115200>;
};

&uart1 {
    status = "disabled";
    current-speed = <115200>;
};