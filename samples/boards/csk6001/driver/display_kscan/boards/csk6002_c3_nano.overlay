&csk6002_c3_nano_pinctrl{
                pinctrl_i2c0_scl_default: i2c0_scl_default{
                        pinctrls = <&pinmuxa 4 8>;
                };
                
                pinctrl_i2c0_sda_default: i2c0_sda_default{
                        pinctrls = <&pinmuxa 5 8>;
                };    

                pinctrl_spi0_sclk_default: spi0_sclk_default {
                        pinctrls = < &pinmuxa 19 6 >;
                };
                pinctrl_spi0_mosi_default: spi0_mosi_default {
                        pinctrls = < &pinmuxa 18 6 >;
                };
                pinctrl_spi0_miso_default: spi0_miso_default {
                        pinctrls = < &pinmuxa 17 6 >;
                };
                pinctrl_spi0_cs_default: spi0_cs_default {
                        pinctrls = < &pinmuxa 20 6 >;
                }; 
};

&spi0 {
    status = "okay";
    pinctrl-0 = <&pinctrl_spi0_sclk_default &pinctrl_spi0_mosi_default &pinctrl_spi0_miso_default &pinctrl_spi0_cs_default>; 
    pinctrl-names = "default";
    
	st7789v@0 {
            compatible = "sitronix,st7789v";
            label = "ST7789V";
            status = "okay";
            spi-max-frequency = <20000000>;
            reg = <0>;
            cmd-data-gpios = <&gpioa 8 1>;
            reset-gpios = <&gpioa 9 0>;
            width = <320>;
            height = <170>;
            x-offset = <0>;
            y-offset = <35>;
            // reg:0xBB
            vcom = <0x1e>;
            // reg:0xB7
            gctrl = <0x35>;
            // reg:0xC3
            vrhs = <0x0b>;
            // reg:0xC4
            vdvs = <0x20>;
            // reg:0x36
            mdac = <0xA3>;
            // reg:0x26
            gamma = <0x01>;
            // reg:0x3a
            colmod = <0x05>;
            // reg:0xc0
            lcm = <0x2c>;
            // reg:0xb2
            porch-param = [0c 0c 00 33 33];
            // reg:0xDF
            cmd2en-param = [5a 69 02 01];
            // reg:0xD0
            pwctrl1-param = [a4 a1];
            // reg:0xE0
            pvgam-param = [d0 06 0b 07 07 24 2e 32 46 37 13 13 2d 33];
            // reg:0xE1
            nvgam-param = [d0 02 06 09 08 05 29 44 42 38 14 14 2a 30];
            // reg:b0
            ram-param = [00 F0];
            // reg:b1
            rgb-param = [CD 08 14];
	};
};

&i2c0 {
        status = "okay";
        pinctrl-0 = <&pinctrl_i2c0_scl_default &pinctrl_i2c0_sda_default>; 
        pinctrl-names = "default";
        bl6xxx@0 {
                compatible = "betterlife,bl6xxx";
                reg = <0>;
                label = "BL6XXX";
                status = "okay";
                int-gpios = <&gpioa 16 0>;
                reset-gpios = <&gpioa 15 0>;
        };
};

