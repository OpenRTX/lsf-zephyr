# Workaround for not being able to have commas in macro arguments

DT_CHOSEN_Z_FLASH_SYSFS_STORAGE := zephyr,flash_sysfs_storage
DT_CHOSEN_Z_FLASH_CONTROLLER := zephyr,flash_controller
DT_CHOSEN_Z_INN_FLASH := zephyr,flash
DT_CHOSEN_Z_IPC_SHM := zephyr,ipc_shm

if USB_MASS_STORAGE

	config DISK_FLASH_START
		default "$(dt_chosen_reg_addr_hex,$(DT_CHOSEN_Z_FLASH_SYSFS_STORAGE))"

	config DISK_FLASH_DEV_NAME
		default "$(dt_chosen_label,$(DT_CHOSEN_Z_FLASH_CONTROLLER))"

	config DISK_VOLUME_SIZE
		default "$(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_FLASH_SYSFS_STORAGE))"


	config DISK_FLASH_MAX_RW_SIZE
		default 4096
		#default $(dt_node_int_prop_hex,$(DT_CHOSEN_Z_INN_FLASH),erase-block-size)

	config DISK_FLASH_ERASE_ALIGNMENT
		default 0x1000
		#default "$(dt_node_int_prop_hex,$(DT_CHOSEN_Z_INN_FLASH),erase-block-size)"

	config DISK_ERASE_BLOCK_SIZE
		default 0x1000
		#default "$(dt_node_int_prop_hex,$(DT_CHOSEN_Z_INN_FLASH),erase-block-size)"
endif


#SOF IPC MEMORY CONFIG
config SOF_IPC_SHM_BASE_ADDRESS
	default "$(dt_chosen_reg_addr_hex,$(DT_CHOSEN_Z_IPC_SHM))"

config SOF_IPC_SHM_SIZE
	default "$(dt_chosen_reg_size_hex,$(DT_CHOSEN_Z_IPC_SHM))"
	help
	  This option specifies size of the memory region to be used
	  for the SOF IPC shared memory

menu "Example Configuration"

    config EXAMPLE_WIFI_SSID
        string "WiFi SSID"
        default "wifi_ssid"

    config EXAMPLE_WIFI_PASSWORD
        string "WiFi password"
        default "wifi_password"

endmenu


config LISA_HEAP_ARENA_SIZE
	int "Size of the lisa mem malloc arena"
	default 0
	help
	  Indicate the size in bytes of the memory arena used for
	  lisa_mem's malloc() implementation.

source "Kconfig.zephyr"
