#include <dt-bindings/gpio/gpio.h>

/ {
	gpio,user {
		compatible = "listenai,csk-gpio-user";

		pwrlock: powerlock {
			gpios = <&gpiob 4 1>;
			label = "power_lock";
		};
	};
};

&spi0 {
		status = "okay";
		miso-gpios = <&gpioa 13 0>;
		mosi-gpios = <&gpioa 10 0>;
		sclk-gpios = <&gpioa 15 0>;
		//sclk-gpios = <&gpioa 11 0>;
		cs-gpios = <&gpioa 12 0>;

		st7789v@0 {
			compatible = "sitronix,st7789v";
			label = "ST7789V";
			status = "okay";
			spi-max-frequency = <40000000>;
			reg = <0>;
			cmd-data-gpios = <&gpioa 14 1>;
			reset-gpios = <&gpiob 6 1>;
			// reset-gpios = <&gpioa 15 1>;
			// te-gpios = <&gpiob 8 1>;
			pinmuxs = <&pinmuxa 14 1>, <&pinmuxb 6 0>;

			width = <320>;
			height = <170>;
			x-offset = <0>;
			y-offset = <35>;
			orientation = <1>;

			// teon = <0x00>;
			// ste = <0>;

			vcom = <0x1e>;
			frctrl2 = <0x05>;
			gctrl = <0x35>;
			vrhs = <0x0b>;
			vdvs = <0x20>;
			mdac = <0x04>;
			gamma = <0x01>;
			colmod = <0x55>;
			lcm = <0x2C>;
			porch-param = [0c 0c 00 33 33];
			cmd2en-param = [5a 69 02 01];
			pwctrl1-param = [a4 a1];
			pvgam-param = [d0 06 0b 07 07 24 2e 32 46 37 13 13 2d 33];
			nvgam-param = [d0 02 06 09 08 05 29 44 42 38 14 14 2a 30];
			ram-param = [00 F0];
			rgb-param = [CD 08 14];
		};
};
